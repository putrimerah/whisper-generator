{
  "name": "whisper-generator",
  "version": "0.1.0",
  "description": "Local meeting transcription: Whisper on your GPU, a web UI, and chatbot-ready exports.",
  "type": "module",
  "bin": {
    "wg": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test src/prompt.test.ts src/server/server.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "ui": "node dist/cli.js ui --open"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
