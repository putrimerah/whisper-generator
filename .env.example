# whisper-generator — per-machine settings
#
#   cp .env.example .env
#
# This file is git-ignored, so paths and tokens stay on your machine.
# Precedence: CLI flags > .env > wg.config.json > built-in defaults.
# Windows paths are accepted everywhere and converted automatically.

# --- locations -------------------------------------------------------------

# Where the file browser opens. Your recordings folder.
WG_BROWSE_ROOT=C:\Users\mirfa\Videos

# Where transcripts are written. One folder per meeting is created inside.
WG_OUTPUT_ROOT=C:\Users\mirfa\OneDrive\Documents\transcripts

# --- transcription ---------------------------------------------------------

# large-v3 is the most accurate that fits a 6 GB GPU. medium is ~3x faster.
WG_MODEL=large-v3

# Forced language, or "auto". Forcing avoids mid-recording language flips.
WG_LANGUAGE=en

# Quantization. int8_float16 fits large-v3 in 6 GB; float16 risks running out.
WG_COMPUTE_TYPE=int8_float16

# Keep the extracted 16 kHz wav (~115 MB/hour) so a re-run skips ffmpeg.
WG_KEEP_AUDIO=false

# Per-word timings. Known crash in faster-whisper 1.2.1; retried without.
WG_WORD_TIMESTAMPS=false

# --- defaults applied to every run -----------------------------------------

# Names that always attend, comma separated.
#WG_ATTENDEES=Irfan

# Project names, acronyms, Malay words Whisper would otherwise spell by ear.
#WG_TERMS=Kafka,Sybil

#WG_CONTEXT=Engineering team meeting

# --- speakers (optional) ---------------------------------------------------

# HuggingFace token for pyannote diarization. Accept the model licence first.
#WG_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
#WG_DIARIZE=false
#WG_SPEAKER_COUNT=0

# --- server ----------------------------------------------------------------

#WG_PORT=7788
